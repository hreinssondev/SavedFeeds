{
    "manifest_version": 3,
    "name": "SavedFeeds Session",
    "description": "Hands your Reddit and Instagram sign-ins in Safari to SavedFeeds, so passkey logins work there too.",
    "version": "1.0",
    "background": {
        "scripts": ["background.js"],
        "type": "module"
    },
    "content_scripts": [
        {
            "js": ["content.js"],
            "matches": ["https://*.instagram.com/*", "https://*.reddit.com/*"],
            "run_at": "document_idle"
        }
    ],
    "permissions": ["cookies", "nativeMessaging"],
    "host_permissions": ["https://*.instagram.com/*", "https://*.reddit.com/*"]
}
